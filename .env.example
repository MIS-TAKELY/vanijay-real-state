# ─── Domains (hostname only — used by Traefik labels in docker-compose.yml) ───
# Each app gets its own domain. Set these to your real domain names.
API_DOMAIN=api.malpoth.com
CLIENT_DOMAIN=malpoth.com
ADMIN_DOMAIN=prashasana.malpoth.com

# ─── Public URLs ──────────────────────────────────────────────────────────────
# Used for CORS, Better Auth trustedOrigins, cookie domains, and baked into
# Next.js at build time via the NEXT_PUBLIC_API_URL build-arg.
CLIENT_URL=https://malpoth.com
ADMIN_URL=https://prashasana.malpoth.com
NEXT_PUBLIC_API_URL=https://api.malpoth.com
# Canonical public origin baked into the client at BUILD time — drives
# metadataBase, canonical/OG URLs, robots.txt and sitemap.xml. MUST be the
# production domain in prod builds (this is what went wrong with lekhaprati).
NEXT_PUBLIC_SITE_URL=https://malpoth.com

# ─── Database (hostname is the Docker service name "postgres") ────────────────
# POSTGRES_PASSWORD is read by the postgres container AND interpolated into
# DATABASE_URL. Keep them in sync if you change the password.
POSTGRES_PASSWORD=change-me

# Inside Docker "postgres" resolves to the postgres service on the internal
# network. For local dev (outside Docker) use localhost instead.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/real-state

# ─── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=generate-a-secure-random-secret
# Must be the public-facing API URL (used for cookie domain & redirects)
BETTER_AUTH_URL=https://api.malpoth.com
# Parent domain shared by the site AND the API. Must be malpoth.com (or
# .malpoth.com), NEVER api.malpoth.com — that cookie is not sent to the
# dashboard host and signed-in users get bounced to /?auth=signin.
COOKIE_DOMAIN=.malpoth.com

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── WhatsApp OTP ─────────────────────────────────────────────────────────────
WHATSAPP_API_URL=https://your-whatsapp-api.example.com/send-message

# ─── Dynamic sitemap revalidation ─────────────────────────────────────────────
# When a property is created/updated/deleted the API pings the Next.js client
# to regenerate /sitemap.xml immediately (instead of waiting up to an hour for
# ISR). SITEMAP_REVALIDATE_SECRET must be identical in both apps.
# CLIENT_INTERNAL_URL is OPTIONAL — the API prefers it (internal Docker DNS,
# no TLS/proxy hop) but falls back to CLIENT_URL if unset. Set it in Docker
# deployments where the public URL routes through Cloudflare, which may 403
# server-to-server pings. Generate a secret with: openssl rand -hex 32
CLIENT_INTERNAL_URL=http://client:3000
SITEMAP_REVALIDATE_SECRET=generate-a-secure-random-secret

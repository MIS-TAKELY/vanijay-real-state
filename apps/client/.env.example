# API URL
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Canonical public origin for metadata, robots.txt and sitemap.xml.
# In production builds this MUST be the real domain (baked at build time).
NEXT_PUBLIC_SITE_URL="https://malpoth.com"

# Google Maps Platform browser API key (Maps JavaScript API + Geocoding API).
# Without it, the listing wizard falls back to the OpenStreetMap Nominatim
# reverse-geocoder and shows a map-unavailable notice instead of the map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# freegoldprice.org API key (live NPR precious-metal rates). The gold market
# page proxies this server-side via /api/gold/live — set it here instead of
# hardcoding the key in the route.
FREEGOLD_API_KEY=""

# gold-api.com API key (price history endpoint, sent as x-api-key header).
# Proxied server-side via /api/gold/history. Free tier: 10 requests/hour,
# daily granularity. Without a valid key the chart falls back to simulated
# data anchored at the live price.
GOLD_API_KEY=""

{
  "name": "@repo/db",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:build-seed": "tsc prisma/seed.ts --outDir . --module commonjs --moduleResolution node --esModuleInterop --target es2019 --skipLibCheck --types node",
    "db:seed": "npm run db:build-seed && node seed.js && rm -f seed.js",
    "build": "prisma generate && tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.0",
    "typescript": "^5.9.2"
  }
}

// Lekhaprati Real Estate Archive (Nepal) — Prisma Schema
// Revised to add: saved searches/alerts, notifications, sold-price records,
// a reusable document vault, centralized government valuation rates,
// agency accounts, officer appointment scheduling, and community Q&A.

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
    BUYER
    SELLER
    AGENCY_AGENT
    AGENCY_ADMIN
    SURVEYOR_AGENT
    ADMIN
}

enum VerificationStatus {
    UNVERIFIED
    LEVEL_1_BASIC
    LEVEL_2_DOC_VERIFIED
    LEVEL_3_FIELD_VERIFIED
    REJECTED
}

enum PropertyStatus {
    DRAFT
    UNDER_VERIFICATION
    LIVE
    SOLD
    ARCHIVED
    REJECTED
}

enum PropertyType {
    RESIDENTIAL_LAND
    COMMERCIAL_LAND
    AGRICULTURAL_LAND
    COMMERCIAL_SPACE
    HERITAGE_HOME
    RESIDENTIAL_HOUSE
}

enum FacingDirection {
    NORTH
    SOUTH
    EAST
    WEST
    NORTH_EAST
    NORTH_WEST
    SOUTH_EAST
    SOUTH_WEST
}

enum RoadType {
    PITCHED
    GRAVEL
    SOIL
    BLOCK_PAVED
    FOOTPATH
}

enum DocumentType {
    LALPURJA // Land Ownership Certificate
    CITIZENSHIP_FRONT // Identity Verification
    CITIZENSHIP_BACK
    TAX_CLEARANCE // Current Fiscal Year Tax Proof
    SURVEY_NAKSA_MAP // Cadastral Survey Map
    PAN_CARD
    OTHER
}

enum DocumentStatus {
    PENDING
    VERIFIED
    REJECTED
    EXPIRED
}

enum MediaType {
    IMAGE
    VIDEO_WALKTHROUGH
    CADASTRAL_MAP
}

enum InquiryType {
    WHATSAPP_CHAT
    VIDEO_WALKTHROUGH_REQUEST
    GENERAL_INQUIRY
    EMI_CALCULATION
}

enum InquiryStatus {
    OPEN
    IN_NEGOTIATION
    CLOSED
}

enum AlertFrequency {
    INSTANT
    DAILY_DIGEST
    OFF
}

enum NotificationType {
    PRICE_DROP
    NEW_LISTING_MATCH
    DOCUMENT_EXPIRING
    DOCUMENT_VERIFIED
    VERIFICATION_STAMP_ISSUED
    OFFICER_APPOINTMENT
    NEW_MESSAGE
    NEW_INQUIRY
    WEEKLY_DIGEST
    SYSTEM
}

enum AppointmentStatus {
    REQUESTED
    SCHEDULED
    COMPLETED
    CANCELLED
    RESCHEDULE_NEEDED
}

enum QuestionCategory {
    LEGAL
    FINANCING
    NRN
    AREA_SPECIFIC
    GENERAL
}

// ==========================================
// USER & AUTH SYSTEM
// ==========================================

// Single merged user table — Better Auth fields + domain business fields.
// Better Auth owns auth concerns (sessions, OAuth, email verification);
// domain fields (role, phone, etc.) live here instead of a separate User table.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  // Domain business fields
  phoneNumber   String?  @unique // e.g. "+97798XXXXXXXX"
  role          UserRole @default(BUYER)
  isVerified    Boolean  @default(false)
  agreedToTerms Boolean  @default(false)
  agencyId      String?
  agency        Agency?  @relation(fields: [agencyId], references: [id])

  sessions Session[]
  accounts Account[]
  profile  UserProfile?

  properties          Property[]             @relation("OwnerProperties")
  assignedAgentFor    Property[]             @relation("AgentProperties")
  inquiries           Inquiry[]
  auditLogs           VerificationAuditLog[] @relation("VerifierAudits")
  documents           UserDocument[]
  savedSearches       SavedSearch[]
  favorites           Favorite[]
  notifications       Notification[]
  questions           Question[]             @relation("QuestionAuthor")
  answers             Answer[]               @relation("AnswerAuthor")
  officerAppointments OfficerAppointment[]   @relation("RequestingUser")

  @@index([phoneNumber])
  @@index([role])
  @@index([agencyId])
  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verifications")
}

model UserProfile {
    id     String @id @default(cuid())
    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    licenseNumber String? // Surveyor / Agency registration number
    avatarUrl     String?
    bio           String?

    // Sensitive — must be encrypted at the application layer before persisting,
    // and access restricted to roles that legitimately need plaintext (admin
    // verification team only). Never return in a general profile API response.
    citizenshipNo        String?
    citizenshipIssueDate DateTime?

    permanentDistrict      String?
    permanentAddress       String?
    preferredLanguage      String  @default("en") // "en" | "ne"
    preferredContactMethod String? // "PHONE" | "WHATSAPP" | "VIBER"

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// Agency accounts (multi-seat) — referenced by User.agencyId above
model Agency {
    id             String  @id @default(cuid())
    name           String
    panVatNumber   String?
    seatsAllowed   Int     @default(1)
    sharedDataPool Boolean @default(false)

    members User[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


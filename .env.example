# ─── Client / Frontend ────────────────────────────────────────────────────────
# Production URL of your client app (used for CORS + better-auth trustedOrigins)
CLIENT_URL=https://realstate.vanijay.com

# Production URL of your API (baked into Next.js at build time)
NEXT_PUBLIC_API_URL=https://realstate-api.vanijay.com

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=generate-a-secure-random-secret
# Must be the public-facing API URL (used for cookie domain & redirects)
BETTER_AUTH_URL=https://realstate-api.vanijay.com

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── WhatsApp OTP ─────────────────────────────────────────────────────────────
WHATSAPP_API_URL=https://your-whatsapp-api.example.com/send-message
